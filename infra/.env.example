# Configuration PostgreSQL locale pour Eparly
# Copier ce fichier vers infra/.env et définir un mot de passe robuste

POSTGRES_DB=eparly_db
POSTGRES_USER=eparly_user
POSTGRES_PASSWORD=example_dev_password_change_me
POSTGRES_PORT=5432

# Développement local uniquement ; ne pas utiliser ces paramètres en production.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=no-reply@eparly.local
JWT_PUBLIC_KEY_LOCATION=file:../../infra/keys/jwt-public.pem
JWT_PRIVATE_KEY_LOCATION=file:../../infra/keys/jwt-private.pem
JWT_ISSUER=eparly-api
JWT_AUDIENCE=eparly-mobile
JWT_ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P30D
EMAIL_VERIFICATION_TTL=PT24H
TERMS_VERSION=v1
MARKETING_NOTICE_VERSION=v1
